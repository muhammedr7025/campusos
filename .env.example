DATABASE_URL="postgresql://campusos:campusos@localhost:5432/campusos?schema=public"

# Auth.js
AUTH_SECRET="dev-only-secret-change-me-in-production-0123456789"
AUTH_URL="http://localhost:3000"

# Local storage adapter (dev). Swap to S3/R2/UploadThing/Supabase Storage in prod
# by implementing another StorageProvider (see lib/storage).
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"

# Shared secret for POST /api/cron/reminders (fee due/overdue, follow-up due,
# KYC pending, assignment due soon). Reminders also run opportunistically on
# app traffic; the cron route makes them punctual.
CRON_SECRET="change-me"
